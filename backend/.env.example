# This file is generated automatically by setup.sh — you normally never
# need to edit it by hand. Kept here only as a reference of what's inside.

DB_USER=studentos
DB_PASSWORD=CHANGE_ME_AUTOGENERATED
DB_NAME=studentos

# 64-byte random secret used to sign short-lived access tokens.
# Autogenerated by setup.sh. Rotating this logs out every access token in
# use (refresh tokens are unaffected and will silently issue a new one).
JWT_ACCESS_SECRET=CHANGE_ME_AUTOGENERATED

# Your domain name, used by Nginx + Certbot for HTTPS.
DOMAIN=api.yourdomain.com
CERTBOT_EMAIL=you@example.com
