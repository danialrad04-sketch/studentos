# Copy to .env.<your-firebase-project-id>; this file contains NO credentials.
# Keep sales false until the Bazaar catalog, receipt verification and live AI pass a device test.
PREMIUM_SALES_ENABLED=false
# Optional comma-separated Firebase account UIDs allowed to test checkout before public sales.
PREMIUM_TESTER_UIDS=
PREMIUM_MONTHLY_PRICE_TOMAN=194500
GEMINI_SERVER_MODEL=gemini-3.5-flash-lite
# Set BAZAAR_API_SECRET, BAZAAR_RSA_PUBLIC_KEY, BILLING_TOKEN_ENCRYPTION_KEY,
# and GEMINI_SERVER_API_KEY via Firebase Secret Manager, not in this file or APK.
