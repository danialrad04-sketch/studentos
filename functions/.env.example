# Non-secret configuration. Copy to .env.YOUR_PROJECT_ID on the deployment machine.
# Store AI_API_KEY with Firebase Secret Manager; never put it in this file or Android.
AI_MODEL=YOUR_PROVIDER_MODEL_ID
AI_API_BASE_URL=https://api.openai.com/v1
AI_TOKEN_PARAMETER=max_completion_tokens
AI_MAX_OUTPUT_TOKENS=4096
AI_DAILY_CHAT_LIMIT=20
AI_DAILY_SCAN_LIMIT=3
AI_DAILY_TOTAL_LIMIT=500
AI_VISION_ENABLED=false

# Existing billing configuration; assistant access does not depend on these values.
PREMIUM_SALES_ENABLED=false
PREMIUM_TESTER_UIDS=
PREMIUM_MONTHLY_PRICE_TOMAN=194500
# Keep BAZAAR_API_SECRET, BAZAAR_RSA_PUBLIC_KEY and BILLING_TOKEN_ENCRYPTION_KEY
# in Firebase Secret Manager. Existing billing providers are unchanged.
