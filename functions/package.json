{
  "name": "studentos-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "check": "node --check index.js && node --check lib/premium-core.js && node --check lib/premium-service.js && node --check lib/support-service.js",
    "test": "node --test test/*.test.js",
    "test:emulator": "firebase emulators:exec --project demo-studentos-premium --only firestore \"node --test test/firebase.test.js\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "^12.0.0",
    "firebase-tools": "15.32.1"
  }
}
