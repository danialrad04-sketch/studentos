<?xml version="1.0" encoding="utf-8"?>
<!--
    Student OS backup policy.
    Sensitive authentication/API credentials are intentionally excluded from
    Android cloud backup; academic data remains available through app backup
    and authenticated sync.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="studentos_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="studentos_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
