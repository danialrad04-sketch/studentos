rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is the authenticated owner of the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // User account document & cloud synced academic data
    match /users/{userId} {
      // Users can read their own profile & subscription metadata
      allow read: if isOwner(userId);
      
      // Client may create identity/profile fields only. All entitlement and admin
      // fields are server-managed and rejected even during first document creation.
      allow create: if isOwner(userId) && !request.resource.data.keys().hasAny([
        'subscriptionTier', 'subscriptionExpiresAt', 'maxDailyAiQuota',
        'allowsCloudSync', 'allowsPdfExport', 'gpaPredictorUnlocked', 'isAdmin'
      ]);
      
      // Entitlements/admin state are writable only by trusted server code.
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'subscriptionTier', 'subscriptionExpiresAt', 'maxDailyAiQuota',
        'allowsCloudSync', 'allowsPdfExport', 'gpaPredictorUnlocked', 'isAdmin'
      ]);
      
      // Allow deletion only by the authenticated owner
      allow delete: if isOwner(userId);

      // Sub-collections: courses, attendance, grades, tasks, profile
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Promo codes repository - Read-only from clients, modified only by Admin
    match /promoCodes/{code} {
      allow read: if request.auth != null;
      allow write: if false; // Only manageable through Firebase Console or Cloud Functions
    }
    
    // In-App Purchases & Play Billing Receipts - Server-side write only
    match /receiptValidation/{receiptId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Written exclusively by verifyPlayBillingReceipt Cloud Function
    }
  }
}
